      kpis={
        <>
          <PremKpi role="admin" label="Total clients" value={String(f.clients.length)} hint="Firm-wide" icon={<Users size={19} />} spark={[2, 3, 4, 5, Math.max(5, f.clients.length)]} />
          <PremKpi role="admin" label="Open filings" value={String(f.openFilings.length)} hint="Across all clients" icon={<FileText size={19} />} />
          <PremKpi role="admin" label="Open tasks" value={String(f.open.length)} hint="Needs action" icon={<Briefcase size={19} />} />
          <PremKpi role="admin" label="Overdue" value={String(f.overdueFilings.length + f.overdueTasks.length)} hint="Act first" icon={<CircleAlert size={19} />} />
        </>
      }
    >
      <ClientsView role="admin" />
    </AdminPageShell>
  );
}

export function AdminTasksPremium() {
  const f = useAdminFacts();
  return (
    <AdminPageShell
      eyebrow="Action centre"
      title="Task management"
      sub="Kanban, priorities and deadlines â€” everything firm-wide in one board."
      stats={[{ v: String(f.open.length), l: "Open" }, { v: String(f.dueSoonTasks.length), l: "Due soon" }, { v: `${f.tasksPct}%`, l: "Done" }]}
      actions={<><PremBtn role="admin" href="/admin/tax-filings">Filings</PremBtn><PremBtn role="admin" href="/admin/performance" ghost>Performance</PremBtn></>}
      kpis={
        <>
          <PremKpi role="admin" label="Open" value={String(f.open.length)} hint="Needs action" icon={<Clock3 size={19} />} />
          <PremKpi role="admin" label="Due soon" value={String(f.dueSoonTasks.length)} hint="Within 3 days" icon={<CalendarDays size={19} />} />
          <PremKpi role="admin" label="Overdue" value={String(f.overdueTasks.length)} hint={f.overdueTasks.length ? "Do these today" : "Nothing overdue"} icon={<CircleAlert size={19} />} />
          <PremKpi role="admin" label="Completed" value={String(f.done.length)} hint="Well done" icon={<CheckCircle2 size={19} />} />
        </>
      }
    >
