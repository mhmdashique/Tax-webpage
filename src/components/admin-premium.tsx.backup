const ADMIN_HELP_FAQS = [
  { q: "How do I approve a new login?", a: "Open Team & Performance â†’ Pending approvals â†’ Approve or Reject with a reason. The new user can log in instantly." },
  { q: "How do I escalate a risky filing?", a: "Open Tax Filings â†’ find the row â†’ Escalate. Open items land on the Escalations page for triage." },
  { q: "How do I review a document?", a: "Open Documents â†’ Open â†’ Accept or Reject with a reason. Rejections go back to the client with your note." },
  { q: "Who can see firm data?", a: "Admins see everything. Employees see only assigned clients; clients see only their own filings, docs and tasks." },
];

export function AdminHelpPremium() {
  const f = useAdminFacts();
  return (
    <AdminPageShell
      eyebrow="Support center"
      title="Help & support"
      sub="All employee and client tickets â€” triage, assign, reply and close."
      stats={[{ v: String(f.ticketOpen), l: "Open" }, { v: String(f.ticketResolved), l: "Resolved" }, { v: String(f.ticketTotal), l: "Total" }]}
      actions={<span className="inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-bold" style={{ background: T.soft, color: T.primary }}><LifeBuoy size={14} /> {f.ticketOpen} open</span>}
      kpis={
        <>
          <PremKpi role="admin" label="Open tickets" value={String(f.ticketOpen)} hint="Awaiting triage" icon={<CircleAlert size={19} />} />
          <PremKpi role="admin" label="Resolved" value={String(f.ticketResolved)} hint="Closed to date" icon={<BadgeCheck size={19} />} />
          <PremKpi role="admin" label="Reopened" value={String(f.ticketReopened)} hint="Still active" icon={<RefreshCw size={19} />} />
          <PremKpi role="admin" label="Total volume" value={String(f.ticketTotal)} hint="All tickets" icon={<LifeBuoy size={19} />} />
        </>
      }
    >
      <div className="min-w-0"><TicketHelpCenter role="admin" /></div>
      <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
        {ADMIN_HELP_FAQS.map((x) => (
          <div key={x.q} className="min-w-0 rounded-[20px] border p-5" style={{ borderColor: "var(--border)", background: "var(--bg)" }}>
            <p className="flex items-center gap-2 text-sm font-bold leading-snug"><LifeBuoy size={15} className="shrink-0" style={{ color: T.primary }} /> {x.q}</p>
            <p className="mt-2 text-sm leading-relaxed" style={{ color: "var(--text-2)" }}>{x.a}</p>
          </div>
        ))}
      </div>
    </AdminPageShell>
  );
}

export function AdminEscalationsPremium() {
  const f = useAdminFacts();
  return (
    <AdminPageShell
      eyebrow="Risk & compliance"
      title="Escalations"
      sub="Open escalations raised by employees â€” confirm resolve or reassign."
      stats={[{ v: String(f.escOpen), l: "Open" }, { v: String(f.escResolved), l: "Resolved" }, { v: String(f.affectedClients), l: "Clients" }]}
      actions={<PremBtn role="admin" href="/admin/clients">View clients</PremBtn>}
      kpis={
        <>
          <PremKpi role="admin" label="Open escalations" value={String(f.escOpen)} hint="Needs attention" icon={<AlertTriangle size={19} />} />
          <PremKpi role="admin" label="Resolved" value={String(f.escResolved)} hint="Confirmed" icon={<CheckCircle2 size={19} />} />
          <PremKpi role="admin" label="Oldest open" value={f.escOpen ? `${f.oldestOpenDays}d` : "â€”"} hint="Days since raised" icon={<Clock3 size={19} />} />
          <PremKpi role="admin" label="Affected clients" value={String(f.affectedClients)} hint="At risk" icon={<Users size={19} />} />
        </>
      }
    >
      {f.escalations.length === 0 ? (
        <div className="space-y-4">
          <EmptyState icon={<AlertTriangle size={22} />} title="No escalations yet" action={<span className="text-xs" style={{ color: "var(--text-2)" }}>Raised items from employees appear here with confirm-resolve actions.</span>} />
          <div className="flex justify-end">
            <Link href="/admin/tax-filings" className="inline-flex items-center gap-2 rounded-lg border px-4 py-2.5 text-sm font-bold" style={{ borderColor: "var(--border)", color: "var(--accent)" }}>Go to filings</Link>
          </div>
        </div>
      ) : (
        <div className="space-y-2">
          {f.escalations.slice(0, 12).map((e: { id: string; status: string; note?: string; created_at?: string }) => (
            <div key={e.id} className="flex items-center gap-3 rounded-xl border px-4 py-3 text-sm" style={{ borderColor: "var(--border)" }}>
              <span className="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl" style={{ background: e.status === "open" ? "var(--warn-bg)" : "var(--success-bg)", color: e.status === "open" ? "var(--warn-tx)" : "var(--success-tx)" }}>
                <AlertTriangle size={16} />
              </span>
              <div className="min-w-0 flex-1">
                <p className="truncate font-bold">{e.note ?? "At-risk item flagged"}</p>
                <p className="text-xs" style={{ color: "var(--text-2)" }}>{e.created_at ? new Date(e.created_at).toLocaleString() : "Raised recently"}</p>
              </div>
              <Badge tone={e.status === "open" ? "warning" : "success"}>{e.status === "open" ? "Open" : "Resolved"}</Badge>
            </div>
          ))}
        </div>
      )}
    </AdminPageShell>
  );
}
export { useAdminFacts };

