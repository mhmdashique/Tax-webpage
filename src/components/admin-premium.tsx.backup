export function AdminPerformancePremium() {
  const f = useAdminFacts();
  const rate = f.filings.length ? Math.round((f.doneFilings.length / f.filings.length) * 100) : 0;
  return (
    <AdminPageShell
      eyebrow="Growth"
      title="My performance"
      sub="Firm-wide completion, throughput and risk â€” live from every scope."
      stats={[{ v: String(f.doneFilings.length), l: "Filed" }, { v: String(f.done.length), l: "Tasks done" }, { v: `${f.score}%`, l: "Score" }]}
      actions={<><PremBtn role="admin" href="/admin/reports">Reports</PremBtn><PremBtn role="admin" href="/admin/tasks" ghost>Tasks</PremBtn></>}
      kpis={
        <>
          <PremKpi role="admin" label="Filings done" value={String(f.doneFilings.length)} hint="Completed returns" icon={<BadgeCheck size={19} />} />
          <PremKpi role="admin" label="Tasks done" value={String(f.done.length)} hint="Closed firm-wide" icon={<CheckCircle2 size={19} />} />
          <PremKpi role="admin" label="On-time rate" value={`${rate}%`} hint="Across firm scope" icon={<Gauge size={19} />} />
          <PremKpi role="admin" label="Overdue load" value={String(f.overdueTasks.length + f.overdueFilings.length)} hint="Clear to improve" icon={<CircleAlert size={19} />} />
        </>
      }
    >
      <div className="grid grid-cols-1 gap-4 xl:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)]">
        <PremCard title="Completion ring" sub="Tasks closed firm-wide">
          <div className="flex min-w-0 items-center gap-4">
            <div className="h-[128px] w-[128px] shrink-0">
              <ResponsiveContainer width="100%" height="100%">
                <RadialBarChart innerRadius="70%" outerRadius="100%" data={[{ name: "x", value: f.tasksPct }]} startAngle={90} endAngle={-270}>
                  <RadialBar dataKey="value" cornerRadius={8} fill={T.primary} background={{ fill: "var(--surface-muted)" }} />
                </RadialBarChart>
              </ResponsiveContainer>
            </div>
            <div className="min-w-0">
              <p className="tnum text-3xl font-bold leading-none">{f.tasksPct}%</p>
              <p className="mt-1 text-xs font-semibold leading-snug" style={{ color: "var(--text-2)" }}>{f.done.length}/{f.tasks.length} tasks complete</p>
              <Link href="/admin/tasks" className="mt-2 inline-flex items-center gap-1 text-xs font-bold hover:underline" style={{ color: T.primary }}>Close more tasks â†’</Link>
            </div>
          </div>
        </PremCard>
        <div className="min-w-0"><PerformanceView role="admin" /></div>
      </div>
    </AdminPageShell>
  );
}

